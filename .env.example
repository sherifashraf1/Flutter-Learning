# =============================================================================
# SECURITY WARNING - READ THIS FIRST!
# =============================================================================
#
# ⚠️  CRITICAL: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
#
# This file is a TEMPLATE ONLY. It contains placeholder values.
#
# IMPORTANT SECURITY PRACTICES:
# 1. Copy this file to `.env` (which is gitignored)
# 2. NEVER commit the actual `.env` file with real secrets
# 3. Use different API keys for development vs production
# 4. Rotate keys immediately if accidentally committed
# 5. Use environment variables or secure storage for production
#
# =============================================================================
# HOW TO USE ENVIRONMENT VARIABLES
# =============================================================================
#
# This app uses TWO different methods for environment variables:
#
# 1. FIREBASE CONFIGURATION (uses --dart-define flags)
#    - firebase_options.dart uses String.fromEnvironment()
#    - Values must be passed at BUILD TIME using --dart-define flags
#    - Example:
#      flutter run --dart-define=FIREBASE_API_KEY_ANDROID=xxx \
#                   --dart-define=FIREBASE_APP_ID_ANDROID=yyy \
#                   --dart-define=FIREBASE_PROJECT_ID=zzz ...
#
#    For production builds:
#      flutter build apk --dart-define=FIREBASE_API_KEY_ANDROID=xxx ...
#      flutter build ios --dart-define=FIREBASE_API_KEY_IOS=xxx ...
#
#    Note: The .env file values below are NOT used for Firebase.
#          They are only for reference/documentation.
#
# 2. API CONFIGURATION (uses .env file with flutter_dotenv)
#    - Books and Movies services use dotenv.env[] to read from .env file
#    - Values are loaded at runtime from the .env file
#    - Copy this file to .env and fill in real values
#
# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# These values are for REFERENCE ONLY. They are NOT loaded from .env file.
# Firebase uses String.fromEnvironment() which requires --dart-define flags.
# See instructions above for how to pass these values at build time.

# Web Platform
FIREBASE_API_KEY_WEB=your_web_api_key_here
FIREBASE_APP_ID_WEB=your_web_app_id_here
FIREBASE_MEASUREMENT_ID_WEB=your_web_measurement_id_here

# Android Platform
FIREBASE_API_KEY_ANDROID=your_android_api_key_here
FIREBASE_APP_ID_ANDROID=your_android_app_id_here

# iOS Platform
FIREBASE_API_KEY_IOS=your_ios_api_key_here
FIREBASE_APP_ID_IOS=your_ios_app_id_here

# macOS Platform
FIREBASE_API_KEY_MACOS=your_macos_api_key_here
FIREBASE_APP_ID_MACOS=your_macos_app_id_here

# Windows Platform
FIREBASE_API_KEY_WINDOWS=your_windows_api_key_here
FIREBASE_APP_ID_WINDOWS=your_windows_app_id_here
FIREBASE_MEASUREMENT_ID_WINDOWS=your_windows_measurement_id_here

# Shared Configuration (used by all platforms)
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=your_auth_domain_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
FIREBASE_IOS_BUNDLE_ID=your_ios_bundle_id_here

# =============================================================================
# API CONFIGURATION
# =============================================================================
# These values ARE loaded from the .env file at runtime using flutter_dotenv.
# Copy this file to .env and provide your actual API keys.

# Books API Configuration (Google Books API)
# Note: Google Books API is free and doesn't require an API key, but you can
#       set a custom base URL if needed.
BOOKS_BASE_URL=https://www.googleapis.com/books

# Movies API Configuration (The Movie Database - TMDB)
# Get your API key from: https://www.themoviedb.org/settings/api
# ⚠️  Keep your TMDB API key secret - do not commit it to version control
MOVIES_BASE_URL=https://api.themoviedb.org/3
API_KEY=your_tmdb_api_key_here